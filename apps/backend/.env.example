# Copy to .env for local dev. Loaded via the environment (Viper AutomaticEnv).
ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://charli:charli@localhost:5432/charli?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# LLM. Defaults below target Google Gemini's free tier over its
# OpenAI-compatible endpoint. Get a free key: https://aistudio.google.com/apikey
#
# LLM_PROVIDER picks the client implementation (see
# internal/shared/infrastructure/llm): "openai" (default — also what Groq,
# Ollama, and most self-hosted endpoints speak), "google" (Gemini's native
# generateContent API), or "deepseek".
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Swap providers by changing the vars above, e.g.:
#   Groq:               LLM_PROVIDER=openai   LLM_BASE_URL=https://api.groq.com/openai/v1                LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:              LLM_PROVIDER=openai   LLM_BASE_URL=http://localhost:11434/v1                     LLM_MODEL=qwen2.5:3b   (key can be anything)
#   DeepSeek:            LLM_PROVIDER=deepseek LLM_BASE_URL=https://api.deepseek.com                      LLM_MODEL=deepseek-chat
#   Gemini (native API): LLM_PROVIDER=google   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta LLM_MODEL=gemini-2.0-flash

# Google OAuth (L4 — Sheets integration). Leave empty to disable; the backend
# starts fine either way. Set up: a Google Cloud project with the Sheets API
# enabled, an OAuth 2.0 "Web application" client, redirect URI
# http://localhost:8080/api/v1/integrations/google/callback, scope
# https://www.googleapis.com/auth/spreadsheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
